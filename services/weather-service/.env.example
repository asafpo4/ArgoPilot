# Copy to .env (kept out of git). Placeholders and defaults only: never put a real API key in this
# file, it is committed. Read by pydantic-settings; a real environment variable wins over this file,
# even an empty one. A missing or invalid variable stops startup with an error that names it.

# The full Open-Meteo forecast endpoint. Required: there is no default, so a missing .env stops the
# service instead of silently calling the internet. A paid plan uses its own host here
# (customer-api.open-meteo.com).
PROVIDER_BASE_URL=https://api.open-meteo.com/v1/forecast

# Optional API key for a paid plan; leave empty for the free API. The key travels in the query string,
# so when it is set, PROVIDER_BASE_URL must use https:// (a host that is exactly localhost, 127.0.0.1
# or ::1 is excepted, for local fakes).
PROVIDER_API_KEY=

# One attempt may take at most this many seconds, from the request to the last byte, including the
# wait for a free connection. A number above 0 and at most 30.
PROVIDER_TIMEOUT_SECONDS=3

# Retries after a failed attempt: a whole number from 0 to 5. All failures are retried.
PROVIDER_RETRIES=2

# Seconds to wait between attempts: a number from 0 to 10.
PROVIDER_RETRY_DELAY_SECONDS=0.5

# Worst-case wait for a request that starts or joins a fetch, in seconds:
#   (PROVIDER_RETRIES + 1) x PROVIDER_TIMEOUT_SECONDS + PROVIDER_RETRIES x PROVIDER_RETRY_DELAY_SECONDS
# This is 10 with the values above, and at most 230 with the largest values allowed.

# A forecast is fresh for this many seconds (and only while its first row is still today at the point).
FRESH_FOR_SECONDS=10800

# An older forecast is served as stale for this many seconds after its fetch, then a 503.
# Never smaller than FRESH_FOR_SECONDS. 86400 is 24 hours.
STALE_MAX_AGE_SECONDS=86400

# After a failed fetch cycle a cell makes no provider call for this many seconds. 0 turns it off.
COOLDOWN_SECONDS=30

# At most this many cells are kept; the least recently used goes first. A whole number of 1 or more.
CACHE_MAX_CELLS=2000
