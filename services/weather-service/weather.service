[Unit]
Description=AgroPilot weather-service
After=network.target

[Service]
WorkingDirectory=/home/ubuntu/ArgoPilot/services/weather-service
ExecStart=/home/ubuntu/ArgoPilot/services/weather-service/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8001 --workers 1
Restart=on-failure

[Install]
WantedBy=multi-user.target