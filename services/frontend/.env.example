# Base URLs of the three services, no trailing path.
# The browser never calls them: pages fetch on the server, so these stay server-side.
# Copy this file to .env.local (never commit .env.local).
REGISTRY_URL=http://127.0.0.1:8000
# Weather is only used for the status line (GET /health). Plans come through the planner.
WEATHER_URL=http://127.0.0.1:8001
PLANNER_URL=http://127.0.0.1:8002
