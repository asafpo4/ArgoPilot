# Copy to .env (kept out of git). Placeholders and defaults only. Read by pydantic-settings; a real
# environment variable wins over this file, even an empty one. An empty value is invalid. A missing
# or invalid variable stops startup with an error that names it (never its value).

# Base URL of registry-service. Required: there is no default, so a missing .env stops the service
# instead of calling a guessed address. http:// or https:// with a host; no user info, query or fragment.
# One trailing "/" is removed.
REGISTRY_BASE_URL=http://127.0.0.1:8000

# Base URL of weather-service. Required, same rule.
WEATHER_BASE_URL=http://127.0.0.1:8001

# One registry attempt may take at most this many seconds, from the request to the last byte.
# A number above 0 and at most 30.
REGISTRY_TIMEOUT_SECONDS=2

# Retries after a failed registry attempt: a whole number from 0 to 5.
REGISTRY_RETRIES=1

# One weather attempt may take at most this many seconds. A number above 0 and at most 240.
# Keep it above weather-service's own worst case (10 s with its defaults).
WEATHER_TIMEOUT_SECONDS=12

# Retries after a failed weather attempt: a whole number from 0 to 5. 0 because weather retries itself.
WEATHER_RETRIES=0

# Seconds to wait between attempts, for both services: a number from 0 to 10.
RETRY_DELAY_SECONDS=0.3

# Worst-case wait of a plan request, in seconds: A + max(A, B), with
#   A = (REGISTRY_RETRIES + 1) x REGISTRY_TIMEOUT_SECONDS + REGISTRY_RETRIES x RETRY_DELAY_SECONDS
#   B = (WEATHER_RETRIES + 1) x WEATHER_TIMEOUT_SECONDS + WEATHER_RETRIES x RETRY_DELAY_SECONDS
# This is 16.3 with the values above, and 1720 with the largest values allowed.
