# Copy to .env (kept out of git) and uncomment one DATABASE_URL.
# Placeholders only: never put a real URL or password in this file, it is committed.

# PostgreSQL (postgres:// also works):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# SQLite file; a relative path is resolved against the service directory (unset or empty means registry.db):
# DATABASE_URL=sqlite:///registry.db

# Throwaway PostgreSQL database for the PostgreSQL tests; must differ from DATABASE_URL and its user may create schemas:
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/TEST_DBNAME
