# Copy to .env (kept out of git) and uncomment one DATABASE_URL.
# Placeholders only: never put a real URL or password in this file, it is committed.

# PostgreSQL (postgres:// also works):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Read by pydantic-settings. A real environment variable wins over this file.
# Unset or blank DATABASE_URL means the local SQLite file registry.db.
# SQLite file; a relative path is resolved against the service directory:
# DATABASE_URL=sqlite:///registry.db

# Throwaway PostgreSQL database for the PostgreSQL tests; must not be the same database as DATABASE_URL and its user may create schemas:
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/TEST_DBNAME
